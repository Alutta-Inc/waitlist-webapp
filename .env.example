# alutta-website environment. Copy to .env.local for local work; set the same
# names in Vercel (Production AND Preview) for a deploy. Server-only variables
# are unprefixed; anything NEXT_PUBLIC_* ships to the browser and is public.

# The API gateway the server routes forward to (waitlist, referral check,
# careers, institution showcase). Production: https://api.alutta.com
ALUTTA_API_URL=http://localhost:8080

# Cloudflare Turnstile. Required in production; the waitlist route refuses to
# run without the secret. Local dev may set both *_DISABLED=true to skip the
# widget (only honoured when NODE_ENV is not production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostnames a Turnstile token may be solved on. Defaults to alutta.com and
# www.alutta.com; Vercel previews are exempt automatically.
# TURNSTILE_ALLOWED_HOSTNAMES=alutta.com,www.alutta.com
# NEXT_PUBLIC_TURNSTILE_DISABLED=true
# TURNSTILE_DISABLED=true

# Where the product and the job board live, as distinct from this site.
NEXT_PUBLIC_STUDENT_APP_URL=https://app.alutta.com
NEXT_PUBLIC_CAREERS_URL=https://careers.alutta.com

# First-party analytics ingest, called from the browser. Defaults to
# https://api.alutta.com; local: http://localhost:8080
# NEXT_PUBLIC_ANALYTICS_URL=https://api.alutta.com

# Optional. The explainer video (and captions) on the homepage; the CSP
# allows media from this origin when set.
# NEXT_PUBLIC_EXPLAINER_VIDEO_URL=
# NEXT_PUBLIC_EXPLAINER_CAPTIONS_URL=

# Optional. CloudFront prefix for static assets; leave empty to serve /public.
# NEXT_PUBLIC_ASSET_PREFIX=
